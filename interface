interface Printable {
    void print();
}

class Student implements Printable {
    public void print() {
        System.out.println("Student: Rohith");
    }
}

class Teacher implements Printable {
    public void print() {
        System.out.println("Teacher: John");
    }
}

public class Main {
    public static void main(String[] args) {
        Student s = new Student();
        Teacher t = new Teacher();

        s.print();
        t.print();
    }
}
